{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Browser-mode tests are checked by tsconfig.browser-test.json instead: they pull in
  // Vitest's browser matcher types, which conflict with jest-dom's (e.g. toHaveTextContent
  // accepts a RegExp in jest-dom but not in the browser matchers) and would break the
  // jsdom tests' type checking if merged into this program.
  "include": ["src"],
  "exclude": ["src/**/*.browser.test.tsx"]
}

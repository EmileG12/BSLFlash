{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser-test.tsbuildinfo"
  },
  // Only the browser-mode tests, kept in their own program so Vitest's browser matcher
  // types don't leak into the jsdom tests. setup.ts is listed explicitly (nothing imports
  // it — Vitest loads it via setupFiles) so its jest-dom augmentation applies here too.
  "include": ["src/**/*.browser.test.tsx", "src/test/setup.ts"],
  "exclude": []
}
